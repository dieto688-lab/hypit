{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "endpoints": {
    "media.local": {
      "use": "@hypit/media-local",
      "config": {
        "defaultConcurrency": 2,
        "ffmpegPath": "/tmp/hypit-tools/ffmpeg",
        "ffprobePath": "/tmp/hypit-tools/ffprobe"
      }
    },
    "html.local": {
      "use": "@hypit/provider-html-local",
      "config": {
        "workers": 2,
        "defaultConcurrency": 1,
        "chromePath": "/tmp/chrome/chromium",
        "browserGpu": "software",
        "ffmpegPath": "/tmp/hypit-tools/ffmpeg",
        "ffprobePath": "/tmp/hypit-tools/ffprobe"
      }
    }
  }
}
